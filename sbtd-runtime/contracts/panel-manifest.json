{
  "schema_version": "1.0",
  "manifest_version": "1.0.0",
  "release": "v2.1.0-rc.2",
  "source": "PRD v0.2 §12.4 Panel 明细与字段依赖；锁定决定 D14（grill-r1.md）",
  "panels": [
    {
      "panel_id": "overview",
      "title_zh": "概览",
      "order": 1,
      "desktop_span": 12,
      "kind": "kpi",
      "metric_ids": [
        "tasks.touched",
        "tasks.created",
        "tasks.completed_unique",
        "runs.started",
        "gates.evidence_coverage",
        "validations.run_pass_rate"
      ],
      "field_dependencies": ["gate evidence", "coverage", "样本规模"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "展示 unknown／partial 与原因"
    },
    {
      "panel_id": "task-lifecycle",
      "title_zh": "任务生命周期",
      "order": 2,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": [
        "tasks.status_at_end",
        "tasks.completion_events",
        "tasks.reopened"
      ],
      "field_dependencies": ["task_uid", "状态历史", "as_of"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "明确区分最新观察与历史范围末"
    },
    {
      "panel_id": "activity-trend",
      "title_zh": "活动趋势",
      "order": 3,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": [
        "tasks.touched",
        "tasks.completion_events",
        "components.invocations"
      ],
      "field_dependencies": ["occurred_at", "bucket", "source health"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "缺口桶用断线／阴影，不伪造 0"
    },
    {
      "panel_id": "mode-decisions",
      "title_zh": "模式决策",
      "order": 4,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": ["modes.distribution", "modes.recommendation_response"],
      "field_dependencies": ["mode_at_event", "mode_source", "decision events"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "未绑定模式单列；unsupported 指标如实标注不支持"
    },
    {
      "panel_id": "step-performance",
      "title_zh": "步骤性能",
      "order": 5,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": [
        "steps.attempts",
        "steps.success_rate_observed",
        "steps.retry_count",
        "duration.step_p50/p95"
      ],
      "field_dependencies": ["step_definition", "attempt", "duration_basis"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "样本不足时不给有误导性的分位数"
    },
    {
      "panel_id": "blockers",
      "title_zh": "阻塞与中断",
      "order": 6,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": ["runs.interrupted", "duration.blocked_ms"],
      "field_dependencies": ["interval", "reason_code", "closure_quality"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "未闭合区间标示仍在观察／未知"
    },
    {
      "panel_id": "gate-matrix",
      "title_zh": "Gate 矩阵",
      "order": 7,
      "desktop_span": 12,
      "kind": "table",
      "metric_ids": ["gates.required", "gates.evidence_coverage", "gates.rework"],
      "field_dependencies": ["GateEvaluation", "scope_revision"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "declared-only 与 validated 明显区分"
    },
    {
      "panel_id": "component-usage",
      "title_zh": "组件使用",
      "order": 8,
      "desktop_span": 6,
      "kind": "table",
      "metric_ids": ["components.invocations", "components.failure_rate", "components.loaded"],
      "field_dependencies": ["component_kind", "invocation", "version"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "安装存在不算调用"
    },
    {
      "panel_id": "validation-evidence",
      "title_zh": "验证证据",
      "order": 9,
      "desktop_span": 12,
      "kind": "table",
      "metric_ids": [
        "validations.runs",
        "validations.run_pass_rate",
        "tests.first_attempt_pass_rate",
        "tests.final_result_distribution",
        "evidence.stale_count"
      ],
      "field_dependencies": ["validation", "artifact", "source revision"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "HTML 存在或诊断输出不能自动通过"
    },
    {
      "panel_id": "host-model-usage",
      "title_zh": "宿主与模型用量",
      "order": 10,
      "desktop_span": 6,
      "kind": "chart",
      "metric_ids": ["usage.requests", "usage.tokens", "usage.cost_reported"],
      "field_dependencies": ["request_id", "raw usage mapping", "billing_basis"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "未提供 usage 显示不支持／未知，不填 0 也不显示成免费"
    },
    {
      "panel_id": "project-actor-summary",
      "title_zh": "项目与主体汇总",
      "order": 11,
      "desktop_span": 6,
      "kind": "table",
      "metric_ids": [],
      "field_dependencies": ["IDs", "actor binding", "leaf task scope"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "本机未绑定主体独立行"
    },
    {
      "panel_id": "task-audit-detail",
      "title_zh": "任务审计详情",
      "order": 12,
      "desktop_span": 12,
      "kind": "table",
      "metric_ids": [],
      "field_dependencies": ["task/run/step/event 关联"],
      "export_required": true,
      "always_visible": false,
      "insufficient_data_zh": "标记当前预览行数和完整数据总量"
    },
    {
      "panel_id": "data-quality",
      "title_zh": "数据质量",
      "order": 13,
      "desktop_span": 12,
      "kind": "table",
      "metric_ids": ["audit.unlinked_count", "audit.gap_intervals"],
      "field_dependencies": ["CollectionHealth", "DatasetManifest"],
      "export_required": true,
      "always_visible": true,
      "insufficient_data_zh": "必须始终存在，不能随导出隐藏，不以 0 或绿灯冒充"
    }
  ]
}
